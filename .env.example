# ==============================================================================
# AI UGC Studio — Environment Configuration
# ==============================================================================

# --- 1. Sécurité & Authentification du Studio ---
# Code d'accès obligatoire pour déverrouiller le studio (choisir un mot de passe fort en production)
STUDIO_PASSCODE=Definir_Un_Passcode_Fort_2026!

# Clé secrète cryptographique 256-bit pour la signature HMAC-SHA256 des sessions
# Générer avec : openssl rand -hex 32
STUDIO_SESSION_SECRET=

# Durée de validité des sessions en heures (par défaut: 24)
STUDIO_SESSION_HOURS=24

# --- 2. Base de Données Persistante (Turso / LibSQL) ---
# En production, Turso est la source de vérité unique
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- 3. Stockage Sécurisé des Médias (Cloudflare R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# --- 4. Bouclier Financier Anti-Débit & Fournisseurs IA ---
# Plafond mensuel strict en euros (l'application bloque tout appel si dépassé)
MAX_MONTHLY_AI_BUDGET=25.0
AI_SIMULATION_ONLY=false

# Clés d'API officielles des fournisseurs IA (optionnelles; mode découverte sans coût si omises)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
HEYGEN_API_KEY=
RUNWAY_API_KEY=
LUMA_API_KEY=
REPLICATE_API_KEY=

# --- 5. Identité du Studio ---
NEXT_PUBLIC_APP_OWNER_NAME="Rayan"
NEXT_PUBLIC_APP_OWNER_TITLE="Consultant Marketing Digital & Créateur de Contenu"
NEXT_PUBLIC_APP_URL="https://ai-ugc-studio-liard.vercel.app"
